{
  "name": "raylib-wasi",
  "version": "5.5.0-build1",
  "description": "Standalone Raylib 5.5 port and host runtime bridge for WebAssembly (wasm32-wasi) without Emscripten",
  "type": "module",
  "main": "./src/host/index.js",
  "module": "./src/host/index.js",
  "types": "./dist/raylib-host.d.ts",
  "exports": {
    ".": "./src/host/index.js",
    "./host": "./src/host/index.js",
    "./headers": "./dist/headers.js",
    "./reference": "./examples/host-reference.js",
    "./include/*": "./dist/include/*",
    "./lib/*": "./dist/lib/*"
  },
  "dependencies": {
    "wasi-host": "https://github.com/breeze833/wasi-host/releases/download/latest/wasi-host-0.1.0.tgz"
  },
  "files": [
    "src/host",
    "dist/include",
    "dist/lib",
    "dist/raylib-host.js",
    "dist/raylib-host.d.ts",
    "dist/headers.js",
    "dist/headers.d.ts",
    "examples/host-reference.js",
    "docs/HOST_FUNCTIONS.md",
    "scripts/postinstall.js",
    "scripts/setup-wasi-sdk.js",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "postinstall": "node scripts/postinstall.js",
    "toolchain": "node scripts/setup-wasi-sdk.js",
    "build": "make all",
    "test": "node --test test/*.js && node examples/host-reference.js",
    "host-reference": "node examples/host-reference.js",
    "package": "make package"
  },
  "keywords": [
    "raylib",
    "wasi",
    "webassembly",
    "wasm",
    "webgl",
    "gamedev"
  ],
  "author": "breeze833",
  "license": "Zlib",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/breeze833/raylib-wasi.git"
  },
  "bugs": {
    "url": "https://github.com/breeze833/raylib-wasi/issues"
  },
  "homepage": "https://github.com/breeze833/raylib-wasi#readme"
}
